# ============================================================
# Cero Tracker Environment Variables Configuration
# Copy this file to .env.local for local development.
# In Vercel, set these in Project Settings -> Environment Variables.
# ============================================================

# ─── 1. Supabase (Database & Auth) ───────────────────────────
# Client-accessible URL and Anon Key (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Service Role Key (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── 2. Application & Site URL ──────────────────────────────
# Base URL of the deployed application (used for password reset redirects & webhooks)
# e.g., https://cero-tracker.vercel.app or http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://your-app-domain.vercel.app

# ─── 3. System Admin & Security ──────────────────────────────
# Secret key used for signing administrative JWT tokens
JWT_SECRET=your-secure-random-jwt-secret-string

# Fallback credentials for system administrator panel (optional override)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-secure-admin-password

# ─── 4. Google Cloud Service Account (Sheets & Forms) ────────
# Google service account email with access to Google Sheets & Forms API
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Private key for the service account (in PEM format with \n newlines)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── 5. Webhooks & Cron Jobs ─────────────────────────────────
# Secret used to authenticate incoming Google Forms webhooks
WEBHOOK_SECRET=your-webhook-secret-string

# Secret used to authenticate Vercel Cron jobs (e.g., rebuild forms)
CRON_SECRET=your-cron-secret-string
